# pre() needs numeric/factor inputs; coerce char/logical, drop now-constant cols
to_factor <- pv[vapply(model_data[pv], function(x) is.character(x) || is.logical(x), logical(1))]
for (v in to_factor) model_data[[v]] <- factor(model_data[[v]])
model_data[pv] <- lapply(model_data[pv], function(x) if (is.factor(x)) droplevels(x) else x)
keep <- vapply(model_data[pv], function(x) length(unique(x)) > 1, logical(1))
if (any(!keep)) { cat(sprintf("  dropped constant: %s\n", paste(pv[!keep], collapse=", "))); pv <- pv[keep] }
if (OBJECTIVE == "dollars") {
model_data$.target <- md_dollars; fam <- "gaussian"
} else {
model_data$.target <- factor(ifelse(model_data$.is_error, "error", "clean"),
levels = c("error", "clean")); fam <- "binomial"
}
form <- as.formula(paste(".target ~", paste(pv, collapse = " + ")))
has_errors <- model_data %>% filter(over_threshold=="1" & fiscal_year>2019)
no_errors_sampled <- model_data %>% filter(over_threshold=="0" & fiscal_year>2019) %>% sample_n(size=(nrow(has_errors) * 19))
model_data <- bind_rows(has_errors,no_errors_sampled)
model_data <- model_data %>% sample_n(size=nrow(model_data))
table(model_data$over_threshold)
complete   <- stats::complete.cases(earned_income_df[model_cols])
model_data <- earned_income_df[complete, , drop = FALSE]
md_dollars <- err_dollars_all[complete]
cat(sprintf("  N (model) = %d (dropped %d NA rows)\n", nrow(model_data), sum(!complete)))
# pre() needs numeric/factor inputs; coerce char/logical, drop now-constant cols
to_factor <- pv[vapply(model_data[pv], function(x) is.character(x) || is.logical(x), logical(1))]
for (v in to_factor) model_data[[v]] <- factor(model_data[[v]])
model_data[pv] <- lapply(model_data[pv], function(x) if (is.factor(x)) droplevels(x) else x)
keep <- vapply(model_data[pv], function(x) length(unique(x)) > 1, logical(1))
if (any(!keep)) { cat(sprintf("  dropped constant: %s\n", paste(pv[!keep], collapse=", "))); pv <- pv[keep] }
## ── 3. Fit RuleFit ────────────────────────────────────────────────────────────
if (OBJECTIVE == "dollars") {
model_data$.target <- md_dollars; fam <- "gaussian"
} else {
model_data$.target <- factor(ifelse(model_data$.is_error, "error", "clean"),
levels = c("error", "clean")); fam <- "binomial"
}
form <- as.formula(paste(".target ~", paste(pv, collapse = " + ")))
has_errors <- model_data %>% filter(over_threshold=="1" & fiscal_year>2019)
no_errors_sampled <- model_data %>% filter(over_threshold=="0" & fiscal_year>2019) %>% sample_n(size=(nrow(has_errors) * 14))
model_data <- bind_rows(has_errors,no_errors_sampled)
model_data <- model_data %>% sample_n(size=nrow(model_data))
table(model_data$over_threshold)
fit <- pre(formula = form, data = model_data[c(".target", pv)], family = fam,
ntrees = 1000,
maxdepth = 4L,
learnrate = 0.01,
type = "rules",
use.grad = T,
tree.unbiased = F,   # rpart, much faster than ctree at this n
sampfrac = 0.5,          # ~11k rows per tree; big speedup, still diverse
removeduplicates = T,
removecomplements = T,
nfolds = 5,
randomForest = F,
#mtry=3,
verbose = TRUE)
fit <- pre(formula = form, data = model_data[c(".target", pv)], family = fam,
ntrees = 1000,
maxdepth = 4L,
learnrate = 0.01,
type = "rules",
use.grad = T,
tree.unbiased = F,   # rpart, much faster than ctree at this n
sampfrac = 0.5,          # ~11k rows per tree; big speedup, still diverse
removeduplicates = T,
removecomplements = T,
nfolds = 5,
randomForest = F,
#mtry=3,
verbose = TRUE)
#Separately, the rule worth keeping is row 1: unc_rawben_rel_max < 0.99 & gross_by_hh_size < 333 & shelter_expenses >= 1084, at precision 0.40 and lift 4. That one isn't a scale artifact; it's the excess-shelter-deduction population, and it earns its lift on substantive grounds. The household-size rules, by contrast, are near-trivial alone (the broad one flags 71% of the caseload to get there), so their value is only as recall filler late in a net, not as standalone flags.
fit2_rf <- pre(formula = form, data = model_data[c(".target", pv)], family = fam,
ntrees = 3000,
maxdepth = 4L,
learnrate = 0.005,
type = "rules",
use.grad = T,
tree.unbiased = T,   # rpart, much faster than ctree at this n
sampfrac = 0.5,          # ~11k rows per tree; big speedup, still diverse
removeduplicates = T,
removecomplements = T,
nfolds = 3,
randomForest = T,
mtry=1,
verbose = TRUE)
rules0 <- get_rules(PENALTY)
if (nrow(rules0) == 0 && PENALTY == "lambda.1se") {
cat("  No rules at lambda.1se -- retrying at lambda.min ...\n")
PENALTY <- "lambda.min"; rules0 <- get_rules(PENALTY)
}
get_rules <- function(pp)
coef(fit2_rf, penalty.par.val = pp) %>% filter(rule != "(Intercept)", coefficient != 0)
rules0 <- get_rules(PENALTY)
if (nrow(rules0) == 0 && PENALTY == "lambda.1se") {
cat("  No rules at lambda.1se -- retrying at lambda.min ...\n")
PENALTY <- "lambda.min"; rules0 <- get_rules(PENALTY)
}
if (nrow(rules0) == 0)
stop("No rules at either penalty. Check the target: table(model_data$.is_error).")
imp <- pre::importance(fit2_rf, penalty.par.val = PENALTY, plot = FALSE)$baseimps
rm(fit2_rf)
gc()
rm(data_2017)
rm(income_and_clean_data)
rm(original_data)
rm(reconstructed_data)
rm(df)
gc()
save.image("current.RData")
