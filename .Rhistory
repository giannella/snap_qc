maxdepth = 3L,
learnrate = 0.01,
type = "rules",
use.grad = T,
tree.unbiased = F,   # rpart, much faster than ctree at this n
sampfrac = 0.3,          # ~11k rows per tree; big speedup, still diverse
removeduplicates = T,
